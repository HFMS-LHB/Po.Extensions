<UserControl
    x:Class="Po.Demo.Avalonia.Views.TestDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Po.Demo.Avalonia.ViewModels"
    d:DesignHeight="200"
    d:DesignWidth="400"
    x:DataType="vm:TestDialogViewModel"
    mc:Ignorable="d">
    <Border Padding="24" Background="White">
        <StackPanel Spacing="16">
            <TextBlock FontSize="16" Text="{Binding Message}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{Binding StartWorkCommand}" Content="Start Work" />
                <Button Command="{Binding CancelDialogCommand}" Content="Cancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

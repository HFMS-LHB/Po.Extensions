<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Po.Demo.Avalonia.ViewModels"
        xmlns:poNav="https://po.mvvm.top/navigation"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Po.Demo.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        poNav:ViewModelLocator.AutoWireViewModel="True"
        Title="Po.Demo.Avalonia">
    <Grid RowDefinitions="*,Auto">
        <Interaction.Behaviors>
            <EventTriggerBehavior EventName="Loaded">
                <InvokeCommandAction Command="{Binding RegionLoadedCommand}" />
            </EventTriggerBehavior>
        </Interaction.Behaviors>
        <ContentControl Grid.Row="0" poNav:RegionManager.RegionName="MainRegion" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>

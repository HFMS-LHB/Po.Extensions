<Window
    x:Class="Po.Demo.Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:poDialog="https://po.mvvm.top/dialoghost"
    xmlns:poNav="https://po.mvvm.top/navigation"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Po.Demo.Avalonia.ViewModels"
    Title="Po.Demo.Avalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    poNav:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
    <!--<poDialog:PoDialogHost Identifier="Main"></poDialog:PoDialogHost>-->
    <u:OverlayDialogHost HostId="Main">
        <Grid RowDefinitions="*,Auto">
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="Loaded">
                    <InvokeCommandAction Command="{Binding RegionLoadedCommand}" />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
            <ContentControl
                Grid.Row="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                poNav:RegionManager.RegionName="MainRegion" />
        </Grid>
    </u:OverlayDialogHost>
</Window>

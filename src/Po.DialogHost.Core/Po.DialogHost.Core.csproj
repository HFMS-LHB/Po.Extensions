<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Po.DialogHost.Core</PackageId>
    <Version>0.0.1</Version>
    <Description>Control-agnostic dialog framework core for Avalonia MVVM applications.</Description>
    <PackageTags>Avalonia;Dialog;MVVM</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Po.MVVM.Core\Po.MVVM.Core.csproj" />
  </ItemGroup>

</Project>
